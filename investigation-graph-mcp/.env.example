# Demo mode only. Do not put real credentials in this file.
APP_ENV=demo
DEMO_MODE=true
PUBLIC_BASE_URL=http://localhost:8088
BACKEND_PORT=8080
MCP_PORT=8090

# Secret manager support. Production must use a managed secret store.
# Supported labels for downstream deployments: env, vault, aws_secrets_manager,
# gcp_secret_manager, azure_key_vault.
SECRET_MANAGER=env
SECRET_NAMESPACE=investigation-graph-mcp/demo

# Local compose demo uses internal containers only. Put real production values in
# the selected secret manager, never in git.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=investigation_demo
POSTGRES_USER=
POSTGRES_PASSWORD_SECRET_REF=

NEO4J_URI=bolt://neo4j:7687
NEO4J_APP_USER=
NEO4J_APP_PASSWORD_SECRET_REF=
NEO4J_MCP_READONLY_USER=
NEO4J_MCP_READONLY_PASSWORD_SECRET_REF=
NEO4J_ADMIN_USER_SECRET_REF=
NEO4J_ADMIN_PASSWORD_SECRET_REF=

TLS_REQUIRED=true
AUTH_PROVIDER=demo_headers
RATE_LIMIT_PER_MINUTE=60
AUDIT_RETENTION_DAYS=365

