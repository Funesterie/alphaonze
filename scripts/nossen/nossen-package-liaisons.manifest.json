  "rules": {
    "publicPackages": [
      "Use only @nossen/* names.",
      "Keep metadata generic and reusable.",
      "Do not mention private A11/Funesterie operator topology.",
      "Do not include credentials, personal runtime paths, or webhook secrets."
    ],
    "privatePackages": [
      "Use @funeste/* first, with @funesterieindustry/* as fallback.",
      "Use private packages for funesterie.me, MCP, agent, graph, payment, and deployment adapters.",
      "Keep secrets in the approved secret store or process environment only.",
      "Do not reuse the same package name for public and private variants."
    ],
    "dualPackages": [
      "Extract a public reusable core first.",
      "Keep NOSSEN-specific adapters in a private twin.",
      "Publish aligned trains only after local tests and install checks pass."
    ]
  },
