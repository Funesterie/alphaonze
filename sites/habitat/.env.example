# Configuration pour l'Habitat Numérique

# URL du MCP Server pour LightKamel
# Par défaut : utilise le serveur remote de Funesterie
# Pour un serveur local : http://localhost:3000/mcp
MCP_SERVER_URL=https://mcp.funesterie.me/admin/mcp

# Token d'authentification pour le MCP Server (si nécessaire)
# Obtiens-le depuis ton fournisseur MCP
MCP_AUTH_TOKEN=ton_token_ici

# Port du serveur de développement Next.js (optionnel)
PORT=3000
