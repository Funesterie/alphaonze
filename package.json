{
  "name": "funesterie-workspace",
  "private": true,
  "scripts": {
    "build": "npm --prefix a11/frontend run build && node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('a11/frontend/dist','dist',{recursive:true});\"",
    "build:frontend": "npm --prefix a11/frontend run build",
    "build:backend": "npm --prefix a11/backend/apps/server run build",
    "build:a11": "npm --prefix a11 run build:all",
    "worker:archivist": "npm --prefix a11/backend/apps/server run worker:archivist",
    "worker:archivist:dry-run": "npm --prefix a11/backend/apps/server run worker:archivist:dry-run",
    "worker:orchestrator": "npm --prefix a11/backend/apps/server run worker:orchestrator",
    "worker:orchestrator:loop": "npm --prefix a11/backend/apps/server run worker:orchestrator:loop",
    "worker:orchestrator:status": "npm --prefix a11/backend/apps/server run worker:orchestrator:status",
    "dispatch": "npm --prefix a11/backend/apps/server run dispatch --",
    "dispatch:agents": "npm --prefix a11/backend/apps/server run dispatch:agents",
    "dispatch:status": "npm --prefix a11/backend/apps/server run dispatch:status",
    "forge": "node scripts/funesterie-forge.cjs",
    "forge:status": "node scripts/funesterie-forge.cjs status",
    "forge:repo-map": "node scripts/funesterie-forge.cjs repo-map",
    "forge:doctor": "node scripts/funesterie-forge.cjs doctor",
    "github:npmrc": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/github/Write-GitHubNpmrc.ps1",
    "github:packages:dry": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/github/Publish-GitHubPackages.ps1 -DryRun",
    "github:packages:publish": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/github/Publish-GitHubPackages.ps1 -Publish",
    "google:artifact:repos": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/google/Ensure-GoogleArtifactRepos.ps1",
    "google:npmrc": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/google/Write-GoogleArtifactNpmrc.ps1",
    "google:packages:dry": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/google/Publish-GoogleArtifactPackages.ps1 -DryRun",
    "google:packages:publish": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/google/Publish-GoogleArtifactPackages.ps1 -Publish",
    "forge:pr": "node scripts/funesterie-forge.cjs pr-status",
    "forge:ci": "node scripts/funesterie-forge.cjs ci",
    "nossen:index": "node scripts/nossen/nossen-source-index.cjs",
    "nossen:index:dry": "node scripts/nossen/nossen-source-index.cjs --config scripts/nossen/nossen-sources.example.json --max-entries 200",
    "nossen:lan": "node scripts/nossen/nossen-lan-map.cjs",
    "nossen:lan:dry": "node scripts/nossen/nossen-lan-map.cjs --config scripts/nossen/nossen-lan.example.json",
    "nossen:radar": "node scripts/nossen/nossen-lan-map.cjs --config scripts/nossen/nossen-lan.example.json",
    "nossen:radar:sync": "node scripts/nossen/nossen-lan-map.cjs --config scripts/nossen/nossen-lan.example.json --sync --target aura",
    "nossen:bloop": "node scripts/nossen/nossen-bloop.cjs",
    "nossen:bloop:dry": "node scripts/nossen/nossen-bloop.cjs --dry-run",
    "nossen:semantic": "node scripts/nossen/nossen-cortex-semantic.cjs",
    "nossen:semantic:dry": "node scripts/nossen/nossen-cortex-semantic.cjs --dry-run",
    "nossen:cortex": "node scripts/nossen/nossen-cortex-semantic.cjs",
    "nossen:search": "node scripts/nossen/nossen-source-search.cjs",
    "nossen:stats": "node scripts/nossen/nossen-source-search.cjs --stats"
  },
  "version": "0.0.1",
  "funding": {
    "type": "custom",
    "url": "https://funesterie.me/contact/"
  }
}
