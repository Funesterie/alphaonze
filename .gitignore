# Sync .project/sourceTexts/ folder (source text files)

# Don't sync user-specific SQLite databases
.project/*.sqlite

# Don't sync SQLite auxiliary files
.project/*.sqlite-wal
.project/*.sqlite-shm

# Don't sync temporary files
.project/.temp/**

# Don't sync user-specific files
.project/complete_drafts.txt
.project/localProjectSettings.json
.project/localProjectSwap.json
copilot-messages.log

# Archive formats
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.bz2
*.xz

# Windows executables and installers
*.exe
*.msi
*.bat
*.cmd
*.com
*.scr
*.dll

# macOS executables and disk images
*.dmg
*.pkg

# Disk images and virtual machine files
*.iso
*.img
*.vhd
*.vmdk

# System files
.DS_Store
.project/attachments/files/**
node_modules

# Secrets & credentials — jamais committer
secrets/
.codex-tmp/
# Meme intention que .codex-tmp/ mais pour les fichiers a plat que les scripts de
# deploiement laissent a la racine (.codex-tmp-dep-blue.sh, .codex-tmp-dep12.txt) :
# le motif en dossier ne les attrapait pas, et ils portent des chemins de secrets.
.codex-tmp*
credentials.routes.js
credentials.store.js
runtime/auth/
.env
.env.*
*.env
*.env.*
!*.env.example
!.env.example
*.jwt.json
*-client-secret.txt
*-agent-token-*.txt
*-agent-info.json

# Logs runtime
logs/
*.err.log
*.out.log
*.stdout.log

# Runtime généré
runtime/
a11/backend/apps/server/.qflush/
a11/backend/apps/server/knowledge-graph/tasks.json
a11/backend/apps/server/runtime/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Local Netlify folder
.netlify

# Runtime memory and state (generated)
a11/a11_memory/
a11/backend/apps/server/.a11_state/

# SEPA mandate (sensitive)
secrets/google/vivy/workspace_sepa_mandate.json
secrets/google/vivy/workspace_dns_verification.json
secrets/google/vivy/cloudflare_token.json
secrets/google/vivy/gemini_api_key.json

# RSA keys (PKCS#1)
secrets/funesterie-crypto/
secrets/google/vivy/vivy_account_info.json
secrets/funesterie-crypto/neo4j_config.json

# Deploiement / artefacts temporaires (blue-green staging, logs, heartbeats)
.codex-tmp/
.codex-tmp-deploy*
.codex-tmp-tierchk.cjs
.tmp-*
out.mp3
.mcp.json

# Encrypted env files
*.env.enc
*.env.bak
