# Frontend environment example.
# Keep real secrets in .env.local or in the deploy provider environment.

VITE_API_BASE=
VITE_A11_ONLINE_API_BASE_URL=
VITE_A11_LOCAL_API_BASE_URL=

# Optional legacy Google Identity Services button.
# The default Google login uses backend OAuth at /api/auth/google/start.
VITE_GOOGLE_CLIENT_ID=
VITE_ENABLE_GOOGLE_IDENTITY_BUTTON=false

# Optional payment contact methods shown in the subscription panel.
VITE_A11_WERO_PHONE=
VITE_A11_RIB_URL=
VITE_A11_PAYPAL_URL=
VITE_A11_PAYPAL_EMAIL=

# Optional local LLM router URL.
VITE_LLM_ROUTER_URL=

# Optional local request token. Never put a real token in this example file.
VITE_A11_NEZ_TOKEN=

# Server-side only examples. Do not expose these through Vite.
GOOGLE_VISION_API_KEY=
