{
  "name": "@nossen/qflush",
  "version": "1.0.1",
  "private": false,
  "description": "QFlush – Funesterie Command Line & Logic System (ROME, SPYDER, CORTEX, NPZ, PICCOLO, SUPERVISOR).",
  "license": "SEE LICENSE IN LICENSE",
  "funding": {
    "type": "custom",
    "url": "https://paypal.me/funeste38"
  },
  "author": "NOSSEN <contact@funesterie.me>",
  "homepage": "https://github.com/Funesterie/funesterie/tree/master/a11/backend/libs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Funesterie/funesterie.git",
    "directory": "a11/backend/libs"
  },
  "bugs": {
    "url": "https://github.com/Funesterie/funesterie/issues"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "qflush": "dist/cli.js"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": "./dist/rome/engine.js"
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "LICENSE-*",
    "README.md",
    "README-FCL.md",
    "PUBLISH.md",
    "TRADEMARK.md",
    "installers/**/*",
    "examples/**/*"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prestart": "node ../apps/tts/download-onnx.js",
    "build:clean": "rimraf dist && tsc -p .",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "lint": "eslint src --ext .ts,.tsx",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "qflush",
    "funesterie",
    "cli",
    "rome",
    "spyder",
    "cortex",
    "npz",
    "supervisor",
    "nossen",
    "a11"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@nossen/bat": "^1.0.0",
    "@nossen/envaptex": "^1.0.0",
    "@nossen/freeland": "^1.0.0",
    "@nossen/nezlephant": "^1.0.0",
    "@nossen/rome": "^1.0.0",
    "csv-stringify": "^6.7.0",
    "js-yaml": "^4.1.1",
    "node-fetch": "^3.3.2",
    "play-sound": "^1.1.6",
    "sharp": "^0.34.5",
    "tail": "^2.2.6",
    "vitest": "^4.1.6"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.0",
    "eslint": "^10.4.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
