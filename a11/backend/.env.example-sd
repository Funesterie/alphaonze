# Variables d'environnement pour génération SD (Stable Diffusion)
ENABLE_SD=true
# En Railway, préfère un proxy vers ton backend local tunnelé :
# A11_SD_PROXY_URL=https://sd.funesterie.me/api/tools/generate_sd
SD_SCRIPT_PATH=/app/apps/server/tools/sd/generate_sd_image.py
SD_OUTPUT_DIR=/tmp/a11-images
# Optionnel : chemin du binaire Python (sinon python3 par défaut)
# SD_PYTHON_PATH=/usr/bin/python3
