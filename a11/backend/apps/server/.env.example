# Environment variables for A11 Backend
PORT=3000
HOST_SERVER=127.0.0.1
# For local GGUF behind a public tunnel, prefer a dedicated Cerbere hostname
# such as https://cerbere.example.com instead of reusing the A11 API hostname.
LLM_ROUTER_URL=http://127.0.0.1:4545
A11_WORKSPACE_ROOT=/app
A11_RUNTIME_ROOT=/app/runtime
A11_SAFE_DATA_ROOT=/app/runtime/files
# Local Windows offload example:
# A11_RUNTIME_ROOT=E:\Funesterie\runtime
# A11_CACHE_ROOT=E:\Funesterie\cache
# A11_EXPORT_ROOT=E:\Funesterie\exports
# A11_VIDEO_WORK_ROOT=E:\Funesterie\generated\videos
# A11_MATCH_ARENA_GAMES_ROOT=C:\Users\Djeff\Desktop\jeux
# A11_MATCH_ARENA_EXPORT_ROOT=E:\Funesterie\match-arena\sessions
# OLLAMA_MODELS=E:\Funesterie\ollama\models
A11_LLM_PROVIDER=groq
A11_OLLAMA_PRIMARY_MODEL=gemma4:e4b
A11_OLLAMA_FALLBACK_MODEL=
VIVY_CHAT_LOCAL_FIRST=false
VIVY_OLLAMA_BASE_URL=http://127.0.0.1:11434
VIVY_CHAT_LOCAL_MODEL=llama3.2:3b
# Structured image canonicalization can be slower than the main chat lane on local models.
# A11_IMAGE_CANONICALIZER_TIMEOUT_MS=30000
# Dedicated structured-output lane for translation/canonicalization on local Ollama.
# A11_TRANSLATION_BASE_URL=http://127.0.0.1:11434/v1
# A11_TRANSLATION_ALLOW_ANON=true
A11_TRANSLATION_MODEL=llama3.2:latest
A11_LLM_FALLBACK_PROVIDER=ollama
A11_LLM_RUNTIME_FALLBACK_ORDER=ollama,openai,gemini,xai,huggingface,deepseek,together
OLLAMA_BASE=http://127.0.0.1:11434
LLAMA_PORT=4545
LLAMA_BASE=
LOCAL_LLM_URL=
A11_ALLOW_PUBLIC_TUNNEL_LLM=0
# Production image topology on Railway:
# - use only the full proxy URL below
# - keep local Windows paths out of Railway
# - do not reuse A11_VISION_BASE_URL for SD generation
A11_SD_PROXY_URL=https://sd.funesterie.me/api/tools/generate_sd
A11_SD_ALLOW_LOCAL_FALLBACK=false
# Production video topology:
# - Comfy Cloud direct is preferred on Hetzner when the API key is configured.
# - A11_VIDEO_PROXY_URL remains available as a local Windows/RunComfy fallback.
A11_VIDEO_COMFY_CLOUD_ENABLED=1
A11_COMFY_CLOUD_API_KEY=
A11_COMFY_CLOUD_BASE_URL=https://cloud.comfy.org
A11_COMFY_CLOUD_WORKFLOW_PATH=
A11_COMFY_CLOUD_TIMEOUT_MS=2700000
A11_COMFY_CLOUD_POLL_INTERVAL_MS=5000
A11_COMFY_CLOUD_WAN_MODEL=wan2.5-i2v-preview
A11_COMFY_CLOUD_WAN_RESOLUTION=480P
A11_VIDEO_PROXY_URL=
A11_VIDEO_PROXY_TIMEOUT_MS=2700000
A11_VIDEO_ASYNC_JOB_TTL_MS=2700000
# Local Windows only. Leave these empty on Railway/Linux proxy-only deployments.
SD_SCRIPT_PATH=
SD_PYTHON_PATH=
# Stable Diffusion local model selection
# `sd35` prefers stabilityai/stable-diffusion-3.5-medium.
# It usually needs Hugging Face access accepted for the model card on first download.
# `multilingual` keeps BAAI/AltDiffusion-m18 for French-friendly prompts.
# `classic` keeps runwayml/stable-diffusion-v1-5.
SD_MODEL_PROFILE=sd35
# Local CUDA tuning for a 12 GB RTX 5070 / Windows backend:
# SD_DEVICE=cuda
# SD_TORCH_DTYPE=float16
# A11_SD_GPU_SETTLE_MS=1200
# SD_SD3_EXECUTION_MODE=model_cpu_offload
# SD_ENABLE_ATTENTION_SLICING=true
# SD_ENABLE_CHANNELS_LAST=true
# SD_ENABLE_XFORMERS=false
# Optional explicit override if you want a specific Hugging Face repo id.
# SD_MODEL_ID=
# Local video runtime tuning
# A11_VIDEO_SD_STEPS=24
# A11_VIDEO_SD_GUIDANCE_SCALE=6.5
# A11_VIDEO_MP4_CODEC=auto
# A11_VIDEO_MP4_PRESET=p5
# A11_VIDEO_MP4_CQ=21
# A11_VIDEO_FFMPEG_BIN=
TTS_BASE_URL=
TTS_PORT=5002
TTS_MODELS_DIR=
TTS_MODEL_PATH=/app/apps/tts/fr_FR-siwis-medium.onnx
PIPER_BIN=
ENABLE_PIPER_HTTP=false
PIPER_START_CMD=
# Async XTTS/RVC queue and optional pull worker. Keep worker tokens in secrets.
A11_TTS_ASYNC_QUEUE_MAX=50
A11_TTS_XTTS_RVC_CONCURRENCY=1
A11_TTS_XTTS_RVC_QUEUE_MAX=24
A11_TTS_LOCAL_GPU_WORKER_ENABLED=false
A11_LOCAL_GPU_WORKER_TOKEN_FILE=/app/runtime/secrets/local_gpu_worker_token
A11_LOCAL_GPU_WORKER_FALLBACK_MS=45000
A11_LOCAL_GPU_WORKER_LEASE_MS=360000
A11_LOCAL_GPU_WORKER_MAX_ACTIVE=1
A11_LOCAL_GPU_WORKER_MAX_LEASE_EXPIRIES=1
BACKEND=openai
LOCAL_DEFAULT_MODEL=gemma4:e4b
# OPENAI_API_KEY is configured via the deployment secret store.
OPENAI_BASE_URL=https://api.openai.com/v1
NEZ_TOKENS=your-nez-tokens
NEZ_ADMIN_TOKEN=your-admin-token
NEZ_ALLOWED_TOKEN=your-allowed-token
DRAGON_API_TOKEN=
CORS_ORIGINS=https://funesterie.me,https://your-netlify-site.netlify.app
PUBLIC_API_URL=https://a11.funesterie.me
ONNX_MODEL_URL=https://<TON_ENDPOINT_R2>/a11-files/fr_FR-siwis-medium.onnx
QFLUSH_AUTO_START=false
DRAGON_API_URL=
QFLUSH_URL=
QFLUSH_REMOTE_URL=https://a11.funesterie.me/api/qflush/status
QFLUSH_BASE_URL=
A11_QFLUSH_USE_DRAGON=false
QFLUSH_TOKEN=
QFLUSH_CHAT_FLOW=
QFLUSH_MEMORY_SUMMARY_FLOW=a11.memory.summary.v1
QFLUSH_EPHEMERAL_MEMORY_FLOW=a11.memory.ephemeral.v1
A11_QFLUSH_REMOTE_TIMEOUT_MS=15000
A11_QFLUSH_REMOTE_RETRIES=2
A11_QFLUSH_VERIFY_MODE=refuse
A11_EPHEMERAL_CHAT_TTL_SEC=7200
A11_EPHEMERAL_CHAT_CONTEXT_LIMIT=6

# PayPal live/sandbox webhook verification.
# Keep real client credentials and webhook ids only in the deployment secret store.
PAYPAL_ENV=live
PAYPAL_PUBLIC_BASE_URL=https://funesterie.me
PAYPAL_WEBHOOK_URL=https://funesterie.me/api/paypal/webhook
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_RECEIVER_EMAIL=

# Qonto Business API (read-only admin checks).
# Qonto expects Authorization: {login}:{secret-key}, not HTTP Basic/Bearer.
# Prefer QONTO_SECRET_KEY_FILE in local/prod secret stores instead of pasting the key.
QONTO_API_BASE_URL=https://thirdparty.qonto.com/v2
QONTO_API_LOGIN=
QONTO_SECRET_KEY_FILE=
# QONTO_SECRET_KEY=
# Optional comma-separated account ids ignored by Funesterie displays/summaries.
QONTO_EXCLUDED_BANK_ACCOUNT_IDS=
# Optional only when Qonto staging/sandbox requires it.
QONTO_STAGING_TOKEN_FILE=
# QONTO_STAGING_TOKEN=

# Mollie payments API (checkout + webhooks).
# Keep real API keys only in secret stores. Payment creation is disabled by default.
MOLLIE_API_BASE_URL=https://api.mollie.com/v2
MOLLIE_API_KEY_FILE=
# MOLLIE_API_KEY=
MOLLIE_PUBLIC_BASE_URL=https://funesterie.me
MOLLIE_WEBHOOK_URL=https://funesterie.me/api/mollie/webhook
MOLLIE_ALLOW_PAYMENT_CREATE=false

# Storage files (Cloudflare R2 / S3 compatible)
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=a11-files
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_PUBLIC_BASE_URL=https://files.example.com

# Email
EMAIL_FROM=A11 <onboarding@resend.dev>
# RESEND_API_KEY is configured via the deployment secret store.
# SMTP/Gmail fallback (used when RESEND_API_KEY is absent)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false
# GMAIL_USER=your-address@gmail.com
# GMAIL_APP_PASSWORD=your-gmail-app-password

# Image guard
# Enabled by default. Set to 0 only if you explicitly want to bypass
# single-subject cardinality verification and retry.
# A11_IMAGE_CARDINALITY_GUARD=1
# A11_IMAGE_CARDINALITY_MAX_RETRIES=1

# Slack alerts (optional)
SLACK_WEBHOOK_URL=
SLACK_NOTIFY_ERRORS=true

# OCR image preprocessing
# Remote vision/OCR only. This base URL is not used for Stable Diffusion generation.
# A11_VISION_BASE_URL=
# A11_VISION_API_KEY=
# A11_VISION_MODEL=gpt-4o-mini
# Optional local unified vision with Janus on Windows/backend GPU.
# In local mode, set A11_VISION_PROVIDER=janus to prefer the local worker.
# A11_VISION_PROVIDER=janus
# A11_JANUS_ENABLED=true
# Default is CPU + Janus-Pro-1B to leave VRAM available for SD.
# Override these two lines only if you really want Janus on the GPU.
# A11_JANUS_MODEL_ID=deepseek-ai/Janus-Pro-1B
# A11_JANUS_PYTHON_PATH=D:\funesterie\a11\backend\apps\server\tools\vision\venv\Scripts\python.exe
# A11_JANUS_DEVICE=cpu
# A11_JANUS_TORCH_DTYPE=auto
# A11_JANUS_PREFER_LATEST=false
# Production GPU/Podman overlay:
# A11_VISION_PROVIDER=janus
# A11_JANUS_ENABLED=true
# A11_JANUS_PYTHON_PATH=/opt/janus-venv/bin/python
# A11_JANUS_MODEL_ID=deepseek-ai/Janus-Pro-1B
# A11_JANUS_DEVICE=cuda
# A11_JANUS_TORCH_DTYPE=auto
# A11_JANUS_PREFER_LATEST=false
# A11_JANUS_TIMEOUT_MS=180000
# Railway/Linux with bundled Janus venv:
# A11_VISION_PROVIDER=janus
# A11_JANUS_ENABLED=true
# A11_JANUS_PYTHON_PATH=/opt/janus-venv/bin/python
# A11_JANUS_MODEL_ID=deepseek-ai/Janus-Pro-1B
# A11_JANUS_DEVICE=cpu
# A11_JANUS_TORCH_DTYPE=auto
# If the optional Docker Janus install cannot reach GitHub during build,
# the backend keeps deploying and simply runs without the bundled Janus runtime.
# Image pipeline mode:
# - auto: raw for simple single-subject prompts, smart for complex workflows
# - raw: user -> mask -> compile -> SD -> return
# - smart: director + special compiler + retries + memory
# A11_IMAGE_PIPELINE_MODE=auto
# Video generation:
# - current backend: sd-frame-sequence (frame-by-frame over the existing SD pipeline)
# - can later be replaced by a native text-to-video backend behind the same route/runtime
# A11_VIDEO_ENABLED=true
# A11_VIDEO_BACKEND=sd-frame-sequence
# A11_VIDEO_DEFAULT_DURATION_SEC=3
# A11_VIDEO_MAX_DURATION_SEC=8
# A11_VIDEO_DEFAULT_FPS=6
# A11_VIDEO_MAX_FPS=12
# A11_VIDEO_MAX_RENDER_FRAMES=24
# A11_VIDEO_DEFAULT_FORMAT=mp4
# A11_VIDEO_FFMPEG_BIN=ffmpeg
# A11_VIDEO_MP4_CODEC=auto
# A11_VIDEO_MP4_PRESET=p5
# A11_VIDEO_MP4_CQ=21
# A11_VIDEO_FRAME_INIT_STRENGTH=0.28
# A11_VIDEO_WORK_ROOT=/app/runtime/files/generated/videos
# A11_VIDEO_SEQUENCE_PLANNER=auto
# A11_VIDEO_SEQUENCE_PLANNER_IMAGE_AWARE=true
# A11_VIDEO_SEQUENCE_PLANNER_TIMEOUT_MS=90000
# A11_VIDEO_USE_JANUS_FRAME_ANALYSIS=false
# A11_VIDEO_REALITY_CHECK=true
# A11_VIDEO_REALITY_CHECK_FRAME_COUNT=3
# Scoped OpenAI-compatible fallback for translation / vision judge:
# A11_OPENAI_API_KEY=your-openai-key
# A11_OPENAI_BASE_URL=https://api.openai.com/v1
# A11_OPENAI_MODEL=gpt-4o-mini
# A11_TRANSLATION_API_KEY=your-openai-key
# A11_TRANSLATION_BASE_URL=https://api.openai.com/v1
# A11_TRANSLATION_MODEL=gpt-4o-mini
# A11_WAZAA_LLM_ENRICH=true
IMAGE_OCR_ENABLED=true
IMAGE_OCR_MAX_BYTES=4194304
IMAGE_OCR_TARGET_BYTES=2097152
IMAGE_OCR_MAX_WIDTH=1600
IMAGE_OCR_MIN_WIDTH=960
IMAGE_OCR_TIMEOUT_MS=20000

# Vivy Live: jaquette immédiate puis mini-clip muet en boucle dans l'overlay OBS.
VIVY_STREAM_COVER_ENABLED=1
VIVY_STREAM_COVER_URL=http://127.0.0.1:3000/api/tools/generate_sd
VIVY_STREAM_COVER_TIMEOUT_MS=120000
VIVY_STREAM_CLIP_ENABLED=1
VIVY_STREAM_CLIP_PROVIDER=auto
VIVY_STREAM_CLIP_DURATION_SECONDS=3
VIVY_STREAM_CLIP_TIMEOUT_MS=2700000
VIVY_STREAM_FULL_CLIP_ENABLED=1
# economy = montage malin avec quelques boucles; dreamclip = clip généré scène par scène.
VIVY_STREAM_FULL_CLIP_MODE=economy
VIVY_STREAM_FULL_CLIP_SCENES=8
VIVY_STREAM_FULL_CLIP_INSTRUMENTAL_SCENES=8
VIVY_STREAM_FULL_CLIP_UNIQUE_LOOPS=5
VIVY_STREAM_FULL_CLIP_REUSE_CHORUS=1
VIVY_STREAM_FULL_CLIP_GENERATE_SCENE_LOOPS=1
VIVY_STREAM_FULL_CLIP_READY_WAIT_MS=90000
VIVY_STREAM_FULL_CLIP_PROVIDER_FALLBACK=1
VIVY_STREAM_FULL_CLIP_LOOP_SECONDS=8
VIVY_STREAM_FULL_CLIP_WIDTH=1280
VIVY_STREAM_FULL_CLIP_HEIGHT=720
VIVY_STREAM_FULL_CLIP_FPS=24
VIVY_STREAM_FULL_CLIP_CROP_SOURCE_IMAGE=1
VIVY_STREAM_FULL_CLIP_SOURCE_CROP_WIDTH_RATIO=0.58
VIVY_STREAM_FULL_CLIP_SOURCE_CROP_X_BIAS=0.62
VIVY_STREAM_FULL_CLIP_SOURCE_CROP_Y_BIAS=0.5
# Mode Vivy DreamClip: plus cher, mais refuse les faux clips statiques.
# VIVY_STREAM_FULL_CLIP_MODE=dreamclip
# Tarif indicatif par seconde de vidéo générée, utilisé par l'estimation
# de coût de POST /api/vivy/stream/round/clip-mode (garde admin one-shot).
VIVY_STREAM_CLIP_COST_PER_VIDEO_SECOND_EUR=0.06
# Timeout d'écriture des paroles (défaut 300000, plafond 600000). Un LLM
# lent ne doit pas déclencher les paroles de secours: on laisse le modèle
# finir son travail proprement.
VIVY_STREAM_LYRICS_TIMEOUT_MS=480000
# Paroles/chansons Vivy: Groq OSS par défaut; xAI/Grok seulement si explicitement forcé.
VIVY_SONG_PROVIDER=groq
# Fallback OpenRouter (Cerbère) pour les paroles: un parolier premium
# rattrape les sorties faibles. 2 appels/round (écriture + réécriture).
# VIVY_SONG_CERBERE_MODEL=anthropic/claude-sonnet-4.5
# VIVY_SONG_CERBERE_MAX_CALLS=2
# VIVY_SONG_CERBERE_MAX_RETRIES=1
# Modèle Groq pour les chansons: modèle OSS réellement autorisé par le projet Groq actuel.
# Les modèles openai/gpt-oss-* existent dans /models mais peuvent être bloqués côté projet (403).
VIVY_SONG_GROQ_MODEL=llama-3.3-70b-versatile
# Freestyle/intense Twitch: plus de budget pour punchlines/couplets sans contaminer l'ancien contexte.
VIVY_STREAM_FREESTYLE_MAX_CHARS=12000
VIVY_STREAM_FREESTYLE_MAX_TOKENS=10000
# VIVY_STREAM_DREAMCLIP_SCENES=8
# VIVY_STREAM_DREAMCLIP_MAX_DURATION_SECONDS=300
# VIVY_STREAM_DREAMCLIP_MIN_GENERATED_COVERAGE=0.72
# VIVY_STREAM_DREAMCLIP_ALLOW_STATIC_FALLBACK=0

# ACE-Step 1.5 / ComfyUI. Le CFG de l'encodeur Qwen (2) est distinct du CFG
# KSampler du turbo (1). Le latent ACE borne la durée réelle à 1000 secondes.
VIVY_ACESTEP_LYRICS_MAX_CHARS=24000
ACESTEP_DIFFUSION_MODEL=acestep_v1.5_turbo.safetensors
ACESTEP_TEXT_ENCODER_1=qwen_0.6b_ace15.safetensors
ACESTEP_TEXT_ENCODER_2=qwen_1.7b_ace15.safetensors
ACESTEP_VAE=ace_1.5_vae.safetensors
ACESTEP_STEPS=8
ACESTEP_KSAMPLER_CFG=1
ACESTEP_LLM_CFG_SCALE=2
ACESTEP_SHIFT=3
ACESTEP_SAMPLER=euler
ACESTEP_SCHEDULER=simple
ACESTEP_DEFAULT_BPM=120
ACESTEP_DEFAULT_DURATION_SECONDS=120
ACESTEP_MAX_DURATION_SECONDS=1000
ACESTEP_TIME_SIGNATURE=4
ACESTEP_LANGUAGE=fr
ACESTEP_KEYSCALE=C minor
ACESTEP_GENERATE_AUDIO_CODES=true
ACESTEP_TEMPERATURE=0.85
ACESTEP_TOP_P=0.9
ACESTEP_TOP_K=0
ACESTEP_MIN_P=0
ACESTEP_MP3_QUALITY=V0

# Social Autoprompt — contexte autorisé pour enrichir Vivy, sans publication automatique.
# Génère une clé longue et stable côté serveur; ne la partage pas.
SOCIAL_TOKEN_ENC_KEY=
SOCIAL_PUBLIC_BASE_URL=https://funesterie.me
# Vide = le worker ingère tous les comptes connectés non pausés.
SOCIAL_CONTEXT_USER_ID=
SOCIAL_YOUTUBE_CLIENT_ID=
SOCIAL_YOUTUBE_CLIENT_SECRET=
SOCIAL_YOUTUBE_REDIRECT_URI=https://funesterie.me/api/admin/social-connect/youtube/callback
# Lecture seule YouTube par défaut.
# SOCIAL_YOUTUBE_SCOPES=openid email profile https://www.googleapis.com/auth/youtube.readonly
SOCIAL_YOUTUBE_INGEST_LIMIT=12
# Meta/Facebook/Instagram est préparé mais la V1 active YouTube en priorité.
SOCIAL_META_APP_ID=
SOCIAL_META_APP_SECRET=
SOCIAL_META_REDIRECT_URI=https://funesterie.me/api/admin/social-connect/meta/callback
# Worker interne sans port public. Il ne publie rien, il fabrique seulement du contexte redacted.
SOCIAL_INGEST_WORKER_ENABLED=1
SOCIAL_INGEST_INTERVAL_MS=900000
PGSSLMODE_DISABLE=1
# Vivy enrichit automatiquement !chanson avec les fiches sociales si la DB contient du contexte.
VIVY_STREAM_SOCIAL_CONTEXT_DISABLED=0
VIVY_STREAM_SOCIAL_CONTEXT_USER_ID=
# Le MCP social demande une auth MCP par défaut.
A11_SOCIAL_MCP_ALLOW_ANONYMOUS=0

# Ekko — module d'écoute audio système (local → prod)
EKKO_TOKEN=ton_token_64_chars_ici
# A11_EKKO_CONTROL_URL=http://a11-ekko:5012

# ─────────────────────────────────────────────────────────────────────────────
# Azure / Microsoft Entra — télémétrie + MCP sécurisé (INERTE tant que non rempli)
# Secrets (CLIENT_SECRET, connection string) → fichier secret / Key Vault, JAMAIS ici.
# ─────────────────────────────────────────────────────────────────────────────
# Entra / Azure AD (app registration -> Overview)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=            # préférer le fichier ci-dessous, pas cette variable
AZURE_CLIENT_SECRET_FILE=/app/runtime/secrets/azure_client_secret
AZURE_AUTHORITY_HOST=https://login.microsoftonline.com
# Azure (souscription / ressources)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=francecentral
# Télémétrie — Application Insights (Overview -> Connection string)
# Se lit depuis l'env conteneur; garder la valeur hors git.
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=a11-server
OTEL_SERVICE_VERSION=
OTEL_DEPLOYMENT_ENVIRONMENT=prod
# OTEL_SDK_DISABLED=1            # force la télémétrie OFF même si connection string présente
# MCP sécurisé via Entra (server-to-server ; s'ajoute aux tokens statiques/OAuth existants)
MCP_AUTH_PROVIDER=entra
MCP_ISSUER=https://login.microsoftonline.com/${AZURE_TENANT_ID}/v2.0
MCP_AUDIENCE=api://<MCP_API_CLIENT_ID>
MCP_SCOPE=api://<MCP_API_CLIENT_ID>/MCP.Access
MCP_ALLOWED_CLIENT_IDS=
MCP_ALLOWED_GROUP_IDS=
# Microsoft Graph (client credentials serveur-à-serveur)
MS_GRAPH_SCOPE=https://graph.microsoft.com/.default
# Dev local seulement — bypass l'auth Entra (ignoré si NODE_ENV=production)
# DEV_AUTH_BYPASS=1
