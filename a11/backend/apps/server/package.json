{
  "name": "a11-server",
  "version": "0.0.1",
  "funding": {
    "type": "custom",
    "url": "https://funesterie.me/contact/"
  },
  "private": true,
  "description": "Backend AlphaOnze server (Express)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": "./dist/rome/engine.js"
  },
  "scripts": {
    "dev": "node server.cjs",
    "dev:a11": "node server-a11.cjs",
    "dev:kaen44": "node server-kaen44.cjs",
    "start": "node scripts/start-with-workers.cjs",
    "start:a11": "node scripts/start-with-workers.cjs server-a11.cjs",
    "start:kaen44": "node scripts/start-with-workers.cjs server-kaen44.cjs",
    "start:watchdog": "node cerbere-watchdog.cjs",
    "dev:watchdog": "node cerbere-watchdog.cjs",
    "dev:router": "node llm-router-runner.cjs",
    "postinstall": "patch-package",
    "test": "echo 'No tests specified for server'",
    "test:contracts": "node --test ./test/*.node.test.cjs",
    "test:mcp": "node --test ./test/mcp-server.node.test.cjs ./test/worker-launch.node.test.cjs ./test/worker-supervisor.node.test.cjs",
    "test:e2e:artifact": "node tests/a11-artifact-flow.e2e.cjs",
    "test:neo4j": "node test-neo4j-connection.cjs",
    "test:stripe": "node test-stripe-integration.cjs",
    "test:subscription": "node test-subscription-flow.cjs",
    "smoke:kaen44": "node scripts/smoke-kaen44-public.cjs",
    "seed:route-map": "node scripts/seed-a11-local-route-map.cjs",
    "memory:status": "node scripts/a11-memory-router.cjs status",
    "memory:search": "node scripts/a11-memory-router.cjs search",
    "memory:write-note": "node scripts/a11-memory-router.cjs write-note",
    "memory:sync-local": "node scripts/a11-memory-router.cjs sync-local",
    "memory:backup-seagate": "node scripts/a11-memory-router.cjs backup-seagate",
    "mcp:autopilot": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\..\\..\\ops\\a11-mcp-ai-autopilot.ps1",
    "mcp:autopilot:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\..\\..\\ops\\a11-mcp-ai-autopilot.ps1 -SyncLocal -PostOk",
    "mcp:autopilot:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\..\\..\\ops\\a11-mcp-ai-autopilot.ps1 -Backup -PostOk",
    "mcp:hook": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\..\\..\\ops\\a11-mcp-ai-autopilot.ps1 -RegisterHook -PostOk",
    "mcp:hook:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\..\\..\\ops\\a11-mcp-ai-autopilot.ps1 -RegisterHookDryRun",
    "sync:codex-neo4j": "node scripts/sync-codex-vs-neo4j.cjs",
    "sync:codex-neo4j:podman": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-codex-neo4j-sync.ps1",
    "sync:runtime-hooks-neo4j": "node scripts/sync-runtime-hooks-neo4j.cjs",
    "sync:runtime-hooks-neo4j:dry-run": "node scripts/sync-runtime-hooks-neo4j.cjs --dry-run",
    "seed:agent-domain-pack": "node scripts/seed-agent-domain-pack.cjs --dry-run",
    "sync:agent-domain-pack-neo4j": "node scripts/seed-agent-domain-pack.cjs",
    "sync:agent-domain-pack-neo4j:dry-run": "node scripts/seed-agent-domain-pack.cjs --dry-run",
    "sync:ecosystem-scope-neo4j": "node scripts/sync-ecosystem-scope-neo4j.cjs",
    "sync:ecosystem-scope-neo4j:dry-run": "node scripts/sync-ecosystem-scope-neo4j.cjs --dry-run",
    "sync:ecosystem-corpus-neo4j": "node scripts/sync-ecosystem-corpus-neo4j.cjs",
    "sync:ecosystem-corpus-neo4j:dry-run": "node scripts/sync-ecosystem-corpus-neo4j.cjs --dry-run",
    "generate:ecosystem-briefing": "node scripts/generate-ecosystem-briefing.cjs",
    "generate:ecosystem-briefing:pdf": "node scripts/generate-ecosystem-briefing.cjs --pdf",
    "ensure:runtime-modules": "node scripts/ensure-runtime-modules.cjs",
    "chopper:status": "node scripts/westside-chopper.cjs status",
    "chopper:plan": "node scripts/westside-chopper.cjs plan",
    "chopper:rumble": "node scripts/westside-chopper.cjs rumble",
    "chopper:recipes": "node scripts/westside-chopper.cjs recipes",
    "chopper:doctor": "node scripts/westside-chopper.cjs doctor",
    "chopper:assemble": "node scripts/westside-chopper.cjs assemble",
    "mixer:status": "node scripts/funesterie-mixer.cjs status",
    "mixer:route": "node scripts/funesterie-mixer.cjs route",
    "mixer:write": "node scripts/funesterie-mixer.cjs write",
    "worker:archivist": "node scripts/identity-archivist-worker.cjs --write-corpus",
    "worker:archivist:dry-run": "node scripts/identity-archivist-worker.cjs --dry-run",
    "worker:orchestrator": "node scripts/orchestrator-worker.cjs --once",
    "worker:orchestrator:loop": "node scripts/orchestrator-worker.cjs --loop",
    "worker:orchestrator:status": "node scripts/orchestrator-worker.cjs --status",
    "dispatch": "node scripts/task-dispatcher.cjs",
    "dispatch:agents": "node scripts/task-dispatcher.cjs --agents",
    "dispatch:status": "node scripts/task-dispatcher.cjs --status",
    "db:init": "node init-db.cjs",
    "db:migrate:stripe": "node run-migration.cjs",
    "lint": "echo 'No linting configured for server'",
    "build": "echo 'No build step needed for backend'",
    "railway:build": "echo 'No build step needed for backend'",
    "sonar": "pwsh -File run-sonar-analysis.ps1",
    "sonar:local": "pwsh -File run-sonar-analysis.ps1 -Local",
    "stripe:setup": "pwsh -File setup-stripe.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@nossen/allmight": "^1.0.0",
    "@nossen/bat": "^1.0.0",
    "@nossen/beam": "^1.0.0",
    "@nossen/envaptex": "^1.0.0",
    "@nossen/freeland": "^1.0.0",
    "@nossen/freeland-bros": "^1.0.0",
    "@nossen/morphing": "^1.0.0",
    "@nossen/nezlephant": "^1.0.0",
    "@nossen/qflush": "^1.0.2",
    "@nossen/rome": "^1.0.0",
    "@nossen/scream": "^1.0.0",
    "@nossen/spyder": "^1.0.0",
    "adm-zip": "^0.5.17",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^4.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "neo4j-driver": "^6.0.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.10",
    "open": "^11.0.0",
    "openai": "^6.39.0",
    "patch-package": "^8.0.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "playwright": "^1.60.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.12.4",
    "sharp": "^0.34.5",
    "stripe": "^22.1.1",
    "tesseract.js": "^7.0.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.15",
    "fast-check": "^4.8.0"
  }
}
