{
  "name": "a11-server",
  "version": "1.0.0",
  "description": "Backend AlphaOnze server (Express)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": "./dist/rome/engine.js"
  },
  "scripts": {
    "dev": "node server.cjs",
    "dev:a11": "node server-a11.cjs",
    "dev:kaen44": "node server-kaen44.cjs",
    "start": "node scripts/apply-startup-schema.cjs && node server.cjs",
    "start:a11": "node scripts/apply-startup-schema.cjs && node server-a11.cjs",
    "start:kaen44": "node scripts/apply-startup-schema.cjs && node server-kaen44.cjs",
    "start:watchdog": "node cerbere-watchdog.cjs",
    "dev:watchdog": "node cerbere-watchdog.cjs",
    "dev:router": "node llm-router-runner.cjs",
    "postinstall": "patch-package",
    "test": "echo 'No tests specified for server'",
    "test:contracts": "node --test ./test/*.node.test.cjs",
    "test:e2e:artifact": "node tests/a11-artifact-flow.e2e.cjs",
    "test:neo4j": "node test-neo4j-connection.cjs",
    "test:stripe": "node test-stripe-integration.cjs",
    "test:subscription": "node test-subscription-flow.cjs",
    "smoke:kaen44": "node scripts/smoke-kaen44-public.cjs",
    "seed:route-map": "node scripts/seed-a11-local-route-map.cjs",
    "db:init": "node init-db.cjs",
    "db:migrate:stripe": "node run-migration.cjs",
    "lint": "echo 'No linting configured for server'",
    "build": "echo 'No build step needed for backend'",
    "railway:build": "echo 'No build step needed for backend'",
    "sonar": "pwsh -File run-sonar-analysis.ps1",
    "sonar:local": "pwsh -File run-sonar-analysis.ps1 -Local",
    "stripe:setup": "pwsh -File setup-stripe.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@funeste38/bat": "^1.0.3",
    "@funeste38/envaptex": "^1.0.6",
    "@funeste38/freeland": "^0.2.2",
    "@funeste38/nezlephant": "^1.0.4",
    "@funeste38/qflush": "^4.0.18",
    "@funeste38/rome": "^1.5.5",
    "adm-zip": "^0.5.17",
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^2.0.9",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "neo4j-driver": "^6.0.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.4",
    "open": "^8.4.2",
    "openai": "^6.34.0",
    "patch-package": "^8.0.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "playwright": "^1.60.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.10.0",
    "sharp": "^0.34.5",
    "stripe": "^22.1.0",
    "tesseract.js": "^6.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "fast-check": "^4.7.0"
  }
}
