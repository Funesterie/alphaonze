# A11 Backend - Config online (exposé via Caddy sur Free)
# Copier ce fichier vers .env.local quand le backend est accessible depuis l'extérieur

PORT=3000
HOST_SERVER=127.0.0.1
A11_WORKSPACE_ROOT=D:\projets\funesterie\a11
A11_RUNTIME_ROOT=D:\projets\funesterie\a11\runtime
A11_SAFE_DATA_ROOT=D:\projets\funesterie\a11\runtime\files

# LLM local via Ollama
A11_LLM_PROVIDER=ollama
OLLAMA_BASE=http://127.0.0.1:11434
LLM_ROUTER_URL=http://127.0.0.1:11434
A11_OLLAMA_PRIMARY_MODEL=gemma4:e4b
A11_OLLAMA_FALLBACK_MODEL=llama3.2:latest
DEFAULT_MODEL=gemma4:e4b
LOCAL_DEFAULT_MODEL=gemma4:e4b
A11_LLM_FALLBACK_PROVIDER=none

# ============================================================
# LLM Cloud Fallbacks
# ============================================================
A11_LLM_FALLBACK_PROVIDER=openai

# Groq (gratuit, ultra rapide)
GROQ_API_KEY=<GROQ_API_KEY>
GROQ_MODEL=llama-3.3-70b-versatile

# Together AI (llama open source, gratuit)
# TOGETHER_API_KEY=key_...
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# xAI / Grok (intelligent, API compatible OpenAI)
XAI_API_KEY=<XAI_API_KEY>
XAI_MODEL=grok-3-fast

# HuggingFace (open source, gratuit)
# HF_API_KEY=hf_...
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Désactiver Cerbère (pas de tunnel local)
MANAGE_CERBERE=false
MANAGE_TTS=false

# Sécurité NEZ activée (mode dev = autorise localhost + tokens JWT de session)
NEZ_SECURITY_MODE=dev

# JWT pour les sessions utilisateur (local auth sans PostgreSQL)
JWT_SECRET=
JWT_EXPIRY=7d

# Admin par défaut (pour le local auth)
DEFAULT_ADMIN_USERNAME=Djeff
DEFAULT_ADMIN_PASSWORD=1991
DEFAULT_ADMIN_EMAIL=djeff@a11.local

# CORS - inclure le domaine public
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:5173,http://localhost:3000,https://alphaonze.funesterie.pro

# Backend mode
BACKEND=local

# Servir le frontend buildé depuis dist/
SERVE_STATIC=true
A11_WEB_DIST_DIR=D:\projets\funesterie\a11\frontend\apps\web\dist

# URL publique (pour les liens générés)
PUBLIC_API_URL=https://alphaonze.funesterie.pro
