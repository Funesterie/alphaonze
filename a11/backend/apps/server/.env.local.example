# A11 Backend Configuration
# Copy this file to .env.local and adjust values as needed

# Server Configuration
PORT=3000
HOST_SERVER=127.0.0.1
A11_WORKSPACE_ROOT=D:\funesterie\a11
A11_RUNTIME_ROOT=D:\funesterie\a11\runtime
A11_SAFE_DATA_ROOT=D:\funesterie\a11\runtime\files

# LLM Router (Cerbère)
LLM_ROUTER_URL=http://127.0.0.1:4545
LLM_ROUTER_PORT=4545
A11_LLM_PROVIDER=ollama
A11_OLLAMA_PRIMARY_MODEL=gemma4:e4b
A11_OLLAMA_FALLBACK_MODEL=
A11_IMAGE_CANONICALIZER_TIMEOUT_MS=30000
A11_TRANSLATION_BASE_URL=http://127.0.0.1:11434/v1
A11_TRANSLATION_ALLOW_ANON=true
A11_TRANSLATION_MODEL=llama3.2:latest
A11_LLM_FALLBACK_PROVIDER=none
OLLAMA_BASE=http://127.0.0.1:11434

# Local LLM Backend
LLAMA_BASE=
LOCAL_LLM_URL=
LLAMA_PORT=4545
DEFAULT_MODEL=gemma4:e4b
LOCAL_DEFAULT_MODEL=gemma4:e4b

# QFlush Process Management
MANAGE_CERBERE=true
MANAGE_TTS=false

# TTS Configuration (optional)
TTS_HOST=http://127.0.0.1:5002
TTS_BASE_URL=
TTS_PORT=5002
TTS_MODELS_DIR=
TTS_MODEL_PATH=apps/tts/fr_FR-siwis-medium.onnx
PIPER_BIN=
ENABLE_PIPER_HTTP=false
PIPER_START_CMD=
TTS_MAX_AGE_SEC=3600
TTS_CLEANUP_INTERVAL_SEC=600

# LLM Configuration
CTX_SIZE=8192
BATCH_SIZE=4096
PARALLEL=8

# Backend Mode
BACKEND=local

# Security (set to 'off' for local development)
NEZ_SECURITY_MODE=off

# CORS Origins (comma-separated)
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:5173,http://localhost:3000,https://funesterie.me

# Email (local)
# Use either Resend or an SMTP/Gmail account for real delivery from local runs.
# RESEND_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false
# GMAIL_USER=your-address@gmail.com
# GMAIL_APP_PASSWORD=your-gmail-app-password

# Qonto Business API (local)
# Keep the real secret in a file outside the repo.
# QONTO_API_BASE_URL=https://thirdparty.qonto.com/v2
# QONTO_API_LOGIN=
# QONTO_SECRET_KEY_FILE=C:\Users\Djeff\.funesterie\secrets\qonto-secret-key.txt
# QONTO_EXCLUDED_BANK_ACCOUNT_IDS=
# QONTO_STAGING_TOKEN_FILE=C:\Users\Djeff\.funesterie\secrets\qonto-staging-token.txt

# Mollie payments API (local)
# Keep the real API key in a file outside the repo.
# MOLLIE_API_BASE_URL=https://api.mollie.com/v2
# MOLLIE_API_KEY_FILE=C:\Users\Djeff\.funesterie\secrets\mollie-api-key.txt
# MOLLIE_PUBLIC_BASE_URL=https://funesterie.me
# MOLLIE_WEBHOOK_URL=https://funesterie.me/api/mollie/webhook
# MOLLIE_ALLOW_PAYMENT_CREATE=false

# Image guard
# Enabled by default. Set to 0 only if you want to disable cardinality retries.
# A11_IMAGE_CARDINALITY_GUARD=1

# GPU Usage (optional)
USE_GPU=false
