{
  "id": "base-literal-image",
  "label": "Base Literal Image",
  "match": {
    "actions": ["generate"]
  },
  "apply": {
    "style": {
      "modifiers": ["haute qualité"]
    },
    "composition": ["sujet bien visible", "composition simple"],
    "constraints": {
      "literalInterpretation": true,
      "safeMode": true,
      "noText": true
    }
  }
}
