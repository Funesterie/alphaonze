# Alpha Onze / A11 backend profile
A11_PRODUCT=a11
A11_INSTANCE_NAME=Alpha Onze
A11_RUNTIME_PROFILE=prod
PORT=3000
SERVE_STATIC=true
PUBLIC_APP_URL=https://a11.funesterie.me
API_URL=https://a11.funesterie.me
A11_PUBLIC_HOST=a11.funesterie.me
A11_USAGE_GUARD_ADMIN_EMAIL=cellaurojeffrey@gmail.com
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct
A11_OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct
A11_CERBERE_PREFER_NON_GROQ=false
A11_LLM_FALLBACK_PROVIDER=openrouter
A11_LLM_RUNTIME_FALLBACK_ORDER=ollama,openrouter,groq,openai,together,xai,huggingface,deepseek

# Video routing: use xAI/Grok Imagine for prompt-only video when a server key is present.
A11_ENABLE_XAI_VIDEO=false
A11_VIDEO_PREFER_XAI=false
A11_XAI_VIDEO_MODEL=grok-imagine-video

# Voice references: keep official raw WAV samples private by default.
# Set this to true only for a controlled internal diagnostic runtime.
A11_TTS_PUBLIC_OFFICIAL_SAMPLES=false
A11_ELEVENLABS_A11_VOICE_ID=
A11_ELEVENLABS_DJEFF_VOICE_ID=
A11_ELEVENLABS_KAEN44_VOICE_ID=
A11_ELEVENLABS_VIVY_VOICE_ID=

# Put secrets in the real .env only, never in this example.
DATABASE_URL=
OPENAI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
A11_LLM_LLAMA=
RESEND_API_KEY=
JWT_SECRET=
