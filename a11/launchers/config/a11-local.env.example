# Copy this file to a11-local.env and adapt if needed.

A11_LOCAL_HOST=127.0.0.1
A11_RUNTIME_ROOT=..\runtime
A11_UI_MODE=embedded
A11_AUTO_OPEN_UI=1
A11_DESKTOP_BROWSER=edge
A11_DESKTOP_WIDTH=1440
A11_DESKTOP_HEIGHT=960

A11_ENABLE_BACKEND=1
A11_ENABLE_TTS=1
A11_ENABLE_LLM=1
A11_ENABLE_QFLUSH=0

A11_BACKEND_PORT=3000
A11_TTS_PORT=5002
A11_LLM_PORT=4545
A11_QFLUSH_PORT=43421
A11_FRONTEND_PORT=5173

A11_PUBLIC_API_URL=https://a11.funesterie.me
A11_PUBLIC_FRONTEND_URL=https://a11.funesterie.me

A11_BACKEND_DIR=..\backend\apps\server
A11_TTS_DIR=..\backend\apps\tts
A11_FRONTEND_DIR=..\frontend\apps\web
A11_WEB_DIST_DIR=..\frontend\apps\web\dist
A11_QFLUSH_DIR=..\a11qflushrailway
A11_LLM_RUNNER=..\backend\apps\server\llm-router-runner.cjs
A11_OLLAMA_BASE=http://127.0.0.1:11434
A11_OLLAMA_PRIMARY_MODEL=gemma4:e4b
A11_OLLAMA_FALLBACK_MODEL=
A11_LLM_FALLBACK_PROVIDER=none
A11_SD_MODEL_PROFILE=sd35
A11_SD_DEVICE=cuda
A11_SD_TORCH_DTYPE=float16
A11_SD_GPU_SETTLE_MS=1200
A11_SD_SD3_EXECUTION_MODE=model_cpu_offload
A11_SD_ENABLE_ATTENTION_SLICING=true
A11_SD_ENABLE_CHANNELS_LAST=true
A11_SD_ENABLE_XFORMERS=false
A11_IMAGE_MAX_RENDER_SIDE=2048
A11_IMAGE_DEFAULT_WIDTH=2048
A11_IMAGE_DEFAULT_HEIGHT=2048
A11_IMAGE_CARDINALITY_MAX_RETRIES=0
A11_VIDEO_DEFAULT_DURATION_SEC=3
A11_VIDEO_MAX_DURATION_SEC=8
A11_VIDEO_DEFAULT_FPS=8
A11_VIDEO_MAX_FPS=16
A11_VIDEO_MAX_RENDER_FRAMES=32
A11_VIDEO_MAX_RENDER_SIDE=2048
A11_VIDEO_DEFAULT_WIDTH=2048
A11_VIDEO_DEFAULT_HEIGHT=2048
A11_VIDEO_SD_STEPS=24
A11_VIDEO_SD_GUIDANCE_SCALE=6.5
A11_VIDEO_FRAME_INIT_STRENGTH=0.24
A11_VIDEO_MP4_CODEC=auto
A11_VIDEO_MP4_PRESET=p5
A11_VIDEO_MP4_CQ=21
A11_VIDEO_FFMPEG_BIN=tools\ffmpeg\bin\ffmpeg.exe
A11_TTS_MODEL=..\backend\apps\tts\fr_FR-siwis-medium.onnx
A11_TTS_PIPER=..\backend\apps\tts\piper.exe
A11_TTS_ESPEAK=..\backend\apps\tts\espeak-ng-data

A11_QFLUSH_CHAT_FLOW=a11.chat.v1
A11_QFLUSH_MEMORY_SUMMARY_FLOW=a11.memory.summary.v1

A11_PACKAGE_ROOT=dist\a11-local
