{
  "name": "a11-local-desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "desktop:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-local-package.ps1",
    "tauri:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable-package.ps1",
    "tauri:installer-lite": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer-lite.ps1",
    "tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri.ps1",
    "tauri:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri.ps1 dev",
    "tauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri.ps1 build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.13"
  }
}
