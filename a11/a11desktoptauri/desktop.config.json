{
  "appName": "A11 Local",
  "shellWindow": {
    "label": "main",
    "title": "A11 Local",
    "width": 560,
    "height": 760,
    "minWidth": 520,
    "minHeight": 720
  },
  "chatWindow": {
    "label": "a11-chat",
    "title": "A11",
    "width": 1480,
    "height": 980,
    "minWidth": 980,
    "minHeight": 720
  },
  "runtime": {
    "host": "127.0.0.1",
    "uiUrl": "http://127.0.0.1:3000",
    "servicePorts": [
      {
        "key": "backend",
        "label": "Backend",
        "port": 3000,
        "required": true,
        "enableEnvKey": "A11_ENABLE_BACKEND"
      },
      {
        "key": "tts",
        "label": "TTS",
        "port": 5002,
        "required": true,
        "enableEnvKey": "A11_ENABLE_TTS"
      },
      {
        "key": "llm",
        "label": "LLM Router",
        "port": 4545,
        "required": true,
        "enableEnvKey": "A11_ENABLE_LLM"
      },
      {
        "key": "qflush",
        "label": "Qflush",
        "port": 43421,
        "required": false,
        "enableEnvKey": "A11_ENABLE_QFLUSH"
      }
    ]
  },
  "installerLite": {
    "enabled": false,
    "defaultModelId": "ollama-gemma4-e4b",
    "defaultModelFileName": "",
    "defaultModelUrl": "",
    "downloadTimeoutSec": 14400
  },
  "modelCatalog": [],
  "remoteProviders": [
    {
      "id": "openai",
      "label": "OpenAI",
      "baseUrl": "https://api.openai.com/v1",
      "defaultModel": "gpt-4o-mini",
      "description": "Connexion directe a OpenAI via une cle API."
    },
    {
      "id": "grok",
      "label": "xAI / Grok",
      "baseUrl": "https://api.x.ai/v1",
      "defaultModel": "",
      "description": "Endpoint compatible OpenAI. Entre le nom du modele xAI de ton compte."
    },
    {
      "id": "openrouter",
      "label": "OpenRouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "defaultModel": "openai/gpt-4o-mini",
      "description": "Routeur multi-modeles compatible OpenAI."
    },
    {
      "id": "custom",
      "label": "Custom OpenAI-compatible",
      "baseUrl": "",
      "defaultModel": "",
      "description": "Pour toute API compatible OpenAI ou Grok-like."
    }
  ],
  "paths": {
    "repoLauncherScript": "../launchers/a11-local.ps1",
    "repoLauncherConfig": "../launchers/config/a11-local.env",
    "repoLogsDir": "../runtime/launcher/logs",
    "packagedRoot": "a11-local",
    "packagedLauncherScript": "launcher/a11-local.ps1",
    "packagedLauncherConfig": "launcher/config/a11-local.env",
    "packagedLogsDir": "runtime/launcher/logs"
  }
}
