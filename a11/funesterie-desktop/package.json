{
    "name":  "funesterie-desktop",
    "version":  "1.0.4",
    "private":  true,
    "description":  "Funesterie Desktop Nexus for PC1 and PC2.",
    "main":  "electron/main.cjs",
    "scripts":  {
                    "dev":  "vite",
                    "electron:dev":  "cross-env FUNESTERIE_DESKTOP_DEV_SERVER=http://127.0.0.1:5177 vite --host 127.0.0.1 --port 5177",
                    "electron:start":  "wait-on http://127.0.0.1:5177 \u0026\u0026 cross-env FUNESTERIE_DESKTOP_DEV_SERVER=http://127.0.0.1:5177 electron .",
                    "build":  "tsc -p tsconfig.json \u0026\u0026 vite build",
                    "dist":  "npm run build \u0026\u0026 electron-builder --win",
                    "dist:portable":  "npm run build \u0026\u0026 electron-builder --win portable",
                    "publish:manifest":  "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Publish-DesktopUpdateManifest.ps1",
                    "sync:mcp-token":  "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Sync-McpTokenToShared.ps1"
                },
    "dependencies":  {
                         "@vitejs/plugin-react":  "^5.1.1",
                         "lucide-react":  "^0.561.0",
                         "react":  "^19.2.3",
                         "react-dom":  "^19.2.3"
                     },
    "devDependencies":  {
                            "@types/react":  "^19.2.14",
                            "@types/react-dom":  "^19.2.3",
                            "autoprefixer":  "^10.4.23",
                            "cross-env":  "^10.1.0",
                            "electron":  "^42.0.1",
                            "electron-builder":  "^26.8.1",
                            "postcss":  "^8.5.6",
                            "tailwindcss":  "^3.4.19",
                            "typescript":  "^5.9.3",
                            "vite":  "^7.2.7",
                            "wait-on":  "^9.0.3"
                        },
    "build":  {
                  "appId":  "me.funesterie.desktop",
                  "productName":  "Funesterie Desktop",
                  "copyright":  "Copyright (c) 2026 Funesterie",
                  "directories":  {
                                      "output":  "release"
                                  },
                  "files":  [
                                "dist/**",
                                "electron/**",
                                "profiles/**",
                                "package.json"
                            ],
                  "extraResources":  [
                                         {
                                             "from":  "../backend/apps/server/src/desktop",
                                             "to":  "desktop-runtime",
                                             "filter":  [
                                                            "**/*.cjs"
                                                        ]
                                         }
                                     ],
                  "win":  {
                              "target":  [
                                             "nsis",
                                             "portable"
                                         ],
                              "icon":  "build/icon.ico",
                              "artifactName":  "Funesterie-Desktop-${version}-${arch}.${ext}"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "Funesterie Desktop"
                           }
              }
}
