{
  "name": "funesterie-desktop",
  "version": "0.0.1",
  "funding": {
    "type": "custom",
    "url": "https://paypal.me/funeste38"
  },
  "private": true,
  "description": "Funesterie Desktop Nexus for PC1 and PC2.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "cross-env FUNESTERIE_DESKTOP_DEV_SERVER=http://127.0.0.1:5177 vite --host 127.0.0.1 --port 5177",
    "electron:start": "wait-on http://127.0.0.1:5177 && cross-env FUNESTERIE_DESKTOP_DEV_SERVER=http://127.0.0.1:5177 electron .",
    "build": "tsc -p tsconfig.json && vite build",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "publish:manifest": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Publish-DesktopUpdateManifest.ps1",
    "sync:mcp-token": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Sync-McpTokenToShared.ps1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "me.funesterie.desktop",
    "productName": "Funesterie Desktop",
    "copyright": "Copyright (c) 2026 Funesterie",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "profiles/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/apps/server/src/desktop",
        "to": "desktop-runtime",
        "filter": [
          "**/*.cjs"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Funesterie-Desktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Funesterie Desktop"
    }
  }
}
