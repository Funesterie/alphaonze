{
  "name": "a11-coder",
  "displayName": "A11 — AI Coding Agent",
  "description": "The best AI coding agent. Powered by A11/funesterie.",
  "version": "1.0.0",
  "funding": {
    "type": "custom",
    "url": "https://paypal.me/funeste38"
  },
  "publisher": "funesterie",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "ai",
    "coding",
    "agent",
    "a11",
    "funesterie",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Funesterie/funesterie"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "a11-sidebar",
          "title": "A11 Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "a11-sidebar": [
        {
          "type": "webview",
          "id": "a11.chatView",
          "name": "Chat"
        },
        {
          "type": "tree",
          "id": "a11.historyView",
          "name": "Historique"
        },
        {
          "type": "tree",
          "id": "a11.statusView",
          "name": "Statut"
        }
      ]
    },
    "commands": [
      {
        "command": "a11.chat",
        "title": "A11: Chat"
      },
      {
        "command": "a11.explain",
        "title": "A11: Expliquer le code"
      },
      {
        "command": "a11.fix",
        "title": "A11: Corriger les erreurs"
      },
      {
        "command": "a11.refactor",
        "title": "A11: Refactoriser"
      },
      {
        "command": "a11.generate",
        "title": "A11: Générer du code"
      },
      {
        "command": "a11.test",
        "title": "A11: Générer des tests"
      },
      {
        "command": "a11.review",
        "title": "A11: Code review"
      },
      {
        "command": "a11.commit",
        "title": "A11: Générer un message de commit"
      },
      {
        "command": "a11.docs",
        "title": "A11: Générer la documentation"
      },
      {
        "command": "a11.optimize",
        "title": "A11: Optimiser les performances"
      },
      {
        "command": "a11.security",
        "title": "A11: Audit de sécurité"
      },
      {
        "command": "a11.login",
        "title": "A11: Se connecter"
      },
      {
        "command": "a11.logout",
        "title": "A11: Se déconnecter"
      },
      {
        "command": "a11.status",
        "title": "A11: Statut du serveur"
      },
      {
        "command": "a11.openChat",
        "title": "A11: Ouvrir le chat"
      },
      {
        "command": "a11.inlineChat",
        "title": "A11: Chat inline"
      },
      {
        "command": "a11.newConversation",
        "title": "A11: Nouvelle conversation"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "a11.explain",
          "group": "a11@1",
          "when": "editorHasSelection"
        },
        {
          "command": "a11.fix",
          "group": "a11@2"
        },
        {
          "command": "a11.refactor",
          "group": "a11@3",
          "when": "editorHasSelection"
        },
        {
          "command": "a11.generate",
          "group": "a11@4"
        },
        {
          "command": "a11.test",
          "group": "a11@5",
          "when": "editorHasSelection"
        },
        {
          "command": "a11.review",
          "group": "a11@6"
        },
        {
          "command": "a11.docs",
          "group": "a11@7",
          "when": "editorHasSelection"
        },
        {
          "command": "a11.optimize",
          "group": "a11@8",
          "when": "editorHasSelection"
        },
        {
          "command": "a11.security",
          "group": "a11@9"
        }
      ],
      "editor/title": [
        {
          "command": "a11.inlineChat",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "a11.chat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "a11.explain",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorHasSelection"
      },
      {
        "command": "a11.fix",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f"
      },
      {
        "command": "a11.inlineChat",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "A11 Agent",
      "properties": {
        "a11.serverUrl": {
          "type": "string",
          "default": "https://a11.funesterie.me",
          "description": "URL du serveur A11 utilise par la VSIX de production"
        },
        "a11.googleClientId": {
          "type": "string",
          "default": "",
          "description": "Client ID Google OAuth public utilise pour la connexion VSIX"
        },
        "a11.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Modèle LLM à utiliser"
        },
        "a11.autoSuggest": {
          "type": "boolean",
          "default": true,
          "description": "Suggestions automatiques"
        },
        "a11.theme": {
          "type": "string",
          "enum": [
            "dark",
            "light",
            "auto"
          ],
          "default": "auto",
          "description": "Thème de l'interface"
        },
        "a11.trialMode": {
          "type": "boolean",
          "default": true,
          "description": "Mode trial (50 requêtes gratuites)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@types/vscode": "^1.120.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^10.4.0",
    "typescript": "^6.0.3"
  }
}
