# Copy to /etc/a11-backup/neo4j-storagebox.env with mode 0600.
# Restic encrypts and authenticates all repository data client-side.
RESTIC_REPOSITORY=sftp:vivy-storage:/./vivy-restic
RESTIC_PASSWORD_FILE=/etc/a11-backup/restic-password
RESTIC_CACHE_DIR=/var/cache/a11-restic
# EX44 already runs a tested root-owned Restic/SFTP backup. Reuse that host
# binary and SSH alias from the root-owned systemd unit. Docker mode is only a
# fallback after a separate image/SSH restore test; Docker access is not a
# security boundary for the deploy account.
A11_BACKUP_RESTIC_MODE=host
# If Docker mode is selected, replace this tag with a reviewed digest.
A11_BACKUP_RESTIC_IMAGE=docker.io/restic/restic:0.18.0
A11_BACKUP_RESTIC_SSH_DIR=/root/.ssh
A11_BACKUP_RESTIC_CACHE_VOLUME=a11-restic-cache

# Leave empty to resolve a11-backend-blue/green from active-color.
A11_BACKUP_BACKEND_CONTAINER=
A11_BACKUP_ACTIVE_COLOR_FILE=/home/deploy/a11-prod/bluegreen/active-color
A11_BACKUP_NEO4J_CONTAINER=a11-neo4j
A11_BACKUP_NEO4J_DATABASE=neo4j
# A native Neo4j dump is the restorable artifact. It needs a brief controlled
# stop; the script restarts the source container even if the dump fails.
A11_BACKUP_NATIVE_DUMP_MODE=required
A11_BACKUP_VERIFY_RESTORE=1
A11_BACKUP_HOST_STAGING_ROOT=/home/deploy/a11-data/runtime/backup-staging/neo4j-storagebox
A11_BACKUP_CONTAINER_STAGING_ROOT=/app/runtime/backup-staging/neo4j-storagebox
A11_BACKUP_ARTIFACT_PATHS=/home/deploy/a11-data/runtime/knowledge-graph:/home/deploy/a11-data/runtime/episodic-memory:/home/deploy/a11-prod/bluegreen
A11_BACKUP_KEEP_DAILY=14
A11_BACKUP_KEEP_WEEKLY=8
A11_BACKUP_KEEP_MONTHLY=12
A11_BACKUP_MAX_SOURCE_BYTES=40000000000
A11_BACKUP_CHECK_SUBSET=1/200
