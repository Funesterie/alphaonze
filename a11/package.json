{
  "name": "a11-control",
  "version": "0.0.1",
  "funding": [
    {
      "type": "paypal",
      "url": "https://paypal.me/funeste38"
    },
    {
      "type": "custom",
      "url": "https://funesterie.me/assets/wero-jeffrey-cellauro-qr.png"
    },
    {
      "type": "custom",
      "url": "https://funesterie.me/contact/"
    }
  ],
  "private": true,
  "description": "Canonical local and production entrypoint for A11",
  "scripts": {
    "start:online": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./launchers/start-online-a11.ps1",
    "bootstrap:ollama:gemma": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./launchers/bootstrap-ollama-gemma.ps1",
    "build:backend": "npm --prefix ./backend/apps/server run railway:build",
    "build:frontend": "npm --prefix ./frontend/apps/web run build",
    "build:all": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm --prefix ./backend/apps/server run test:contracts",
    "test:backend:e2e": "npm --prefix ./backend/apps/server run test:e2e:artifact",
    "test:all": "npm run test:backend",
    "check:llm-assets": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./llm/scripts/check-local-assets.ps1",
    "doctor:git": "git -C .. status --short",
    "doctor:prod": "pwsh -NoProfile -ExecutionPolicy Bypass -Command \"$status = (Invoke-WebRequest -UseBasicParsing 'https://a11.funesterie.me/api/status' | Select-Object -ExpandProperty Content | ConvertFrom-Json); $status | ConvertTo-Json -Depth 10; Write-Host ''; $remoteUrl = [string]$status.integrations.qflush.remoteUrl; if ([string]::IsNullOrWhiteSpace($remoteUrl)) { throw 'Missing qflush remoteUrl in backend status payload.' }; (Invoke-WebRequest -UseBasicParsing (($remoteUrl.TrimEnd('/')) + '/health')).Content\"",
    "docker:health": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./ops/funesterie-docker/health.ps1",
    "docker:login": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./ops/funesterie-docker/login.ps1",
    "docker:build:a11": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./ops/funesterie-docker/build-a11.ps1 -Latest",
    "docker:push:a11": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./ops/funesterie-docker/build-a11.ps1 -Latest -Push",
    "redhat:health": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./ops/funesterie-docker/redhat-health.ps1",
    "shiny:repair-dns": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./ops/funesterie-docker/repair-wsl-dns.ps1",
    "shiny:plan": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./ops/funesterie-docker/thousand-shiny.ps1 -Action plan",
    "shiny:health": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./ops/funesterie-docker/thousand-shiny.ps1 -Action health",
    "shiny:compose-path": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./ops/funesterie-docker/thousand-shiny.ps1 -Action compose-path"
  },
  "funesterieSupport": {
    "paypal": "https://paypal.me/funeste38",
    "weroQr": "https://funesterie.me/assets/wero-jeffrey-cellauro-qr.png",
    "contact": "https://funesterie.me/contact/"
  }
}
